{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "categoryRoute": {
        "ClusterId": "categoryCluster",
        "Match": {
          "Path": "/api/Category/{**catch-all}"
        }
      },

      "loginRoute": {
        "ClusterId": "loginCluster",
        "Match": {
          "Path": "/api/Login/{**catch-all}"
        }
      },

      "orderRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/api/Order/{**catch-all}"
        }
      },

      "userRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/Users/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "categoryCluster": {
        "Destinations": {
          "categoryDestination": {
            "Address": "https://localhost:7301/"
          }
        }
      },

      "loginCluster": {
        "Destinations": {
          "loginDestination": {
            "Address": "https://localhost:7303/"
          }
        }
      },

      "orderCluster": {
        "Destinations": {
          "orderDestination": {
            "Address": "https://localhost:7302/"
          }
        }
      },

      "userCluster": {
        "Destinations": {
          "userDestination": {
            "Address": "https://localhost:7304/"
          }
        }
      }
    }
  },

  "AllowedHosts": "*"
}